{
  "name": "ytm-practice-grabber",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "vitest run",
    "test:e2e": "node build.mjs && vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json",
    "gen-key": "node scripts/gen-key.mjs"
  },
  "devDependencies": {
    "@braccato/parsers": "0.3.2",
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "playwright-core": "1.56.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
